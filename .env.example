QWEN_API_KEY=your-dashscope-or-model-studio-api-key

# Optional but strongly recommended: switches the Realtime WebSocket connection from
# the shared dashscope.aliyuncs.com domain to your workspace-specific domain, which
# fixed a multi-day session.update reliability problem (see docs/qwen-realtime-voice-setup.md).
# Get it from the 百炼 console: https://help.aliyun.com/zh/model-studio/obtain-the-app-id-and-workspace-id
# It looks like "llm-xxxxxxxxxxxxxxxx" -- NOT your account/主账号 UID, which is a
# plain number and gets rejected with "Workspace endpoint is invalid."
QWEN_WORKSPACE_ID=

# Optional overrides -- defaults are qwen3.5-omni-plus-realtime / Ethan, verified
# working against the workspace-specific domain on 2026-08-23.
# QWEN_MODEL=qwen3.5-omni-plus-realtime
# QWEN_VOICE=Ethan

# web-demo/server.py binds 127.0.0.1 by default (local-only). Only set HOST=0.0.0.0
# when fronting it with a tunnel/reverse proxy (e.g. cloudflared) that needs to reach
# it from outside the machine -- and pair it with PRODUCTION=1 below.
# HOST=0.0.0.0

# When set, web-demo/server.py stops registering the AgentNexus mock routes
# (/agentnexus-mock/*) -- they're seed-data-only and not meant to be reachable
# from outside the machine. Set this alongside HOST=0.0.0.0.
# PRODUCTION=1
